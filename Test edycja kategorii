import unittest
import random
import string
import time

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import Select, WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager


class TestEdycjaKategoriiDownload(unittest.TestCase):

    def setUp(self):
        self.LOGIN = "dominikkurda6@gmail.com"
        self.HASLO = "domino2024D"
        self.BASE_URL = "https://ndsbnhq893.go6.publigo.onl"

        self.driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()))
        self.driver.maximize_window()
        self.wait = WebDriverWait(self.driver, 15)

    def losowy_tekst(self, dlugosc=6):
        return ''.join(random.choices(string.ascii_lowercase, k=dlugosc))

    def test_edycja_kategorii_download(self):
        driver = self.driver
        wait = self.wait

        nazwa = "test_" + self.losowy_tekst()
        slug = "slug_" + self.losowy_tekst()

        nowa_nazwa = nazwa + "_edit"
        nowy_opis = "opis po edycji"

        # 1. Logowanie
        driver.get(f"{self.BASE_URL}/wp-login.php")

        wait.until(EC.visibility_of_element_located((By.ID, "user_login"))).send_keys(self.LOGIN)
        driver.find_element(By.ID, "user_pass").send_keys(self.HASLO)
        driver.find_element(By.ID, "wp-submit").click()

        wait.until(EC.presence_of_element_located((By.ID, "wpadminbar")))

        # 2. Wejście w kategorie download
        driver.get(f"{self.BASE_URL}/wp-admin/edit-tags.php?taxonomy=download_category&post_type=download")

        wait.until(EC.visibility_of_element_located((By.ID, "tag-name")))

        # 3. Dodanie kategorii
        driver.find_element(By.ID, "tag-name").send_keys(nazwa)
        driver.find_element(By.ID, "tag-slug").send_keys(slug)

        parent_select = Select(driver.find_element(By.ID, "parent"))
        opcje = [option.text.strip() for option in parent_select.options]

        if "Kursy" in opcje:
            parent_select.select_by_visible_text("Kursy")
        else:
            parent_select.select_by_value("-1")

        driver.find_element(By.ID, "tag-description").send_keys("opis przed edycja")

        wait.until(
            EC.element_to_be_clickable((By.ID, "submit"))
        ).click()

        time.sleep(2)

        lista = wait.until(
            EC.visibility_of_element_located((By.ID, "the-list"))
        ).text.lower()

        self.assertIn(nazwa.lower(), lista)

        # 4. Kliknięcie w kategorię do edycji
        wait.until(
            EC.element_to_be_clickable((By.LINK_TEXT, nazwa))
        ).click()

        # 5. Edycja kategorii
        name_input = wait.until(
            EC.visibility_of_element_located((By.ID, "name"))
        )
        name_input.clear()
        name_input.send_keys(nowa_nazwa)

        opis = driver.find_element(By.ID, "description")
        opis.clear()
        opis.send_keys(nowy_opis)

        # 6. Zapisz zmiany — poprawiony selektor
        wait.until(
            EC.element_to_be_clickable((
                By.CSS_SELECTOR,
                "input.button-primary, button.button-primary, input[type='submit']"
            ))
        ).click()

        time.sleep(2)

        # 7. Walidacja
        driver.get(f"{self.BASE_URL}/wp-admin/edit-tags.php?taxonomy=download_category&post_type=download")
        time.sleep(2)

        lista_po_edycji = wait.until(
            EC.visibility_of_element_located((By.ID, "the-list"))
        ).text.lower()

        self.assertIn(nowa_nazwa.lower(), lista_po_edycji)

        print(f"✅ Kategoria została edytowana: {nazwa} -> {nowa_nazwa}")

    def tearDown(self):
        self.driver.quit()


if __name__ == "__main__":
    unittest.main()
